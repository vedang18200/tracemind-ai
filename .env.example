# Copy to .env and fill in. Never commit .env.

# --- LLM (only needed for the full agent pipeline, not for the MCP server) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_STRONG=

# --- Web search used by the MCP search_web tool (free tier at tavily.com) ---
TAVILY_API_KEY=

# --- Postgres (docker compose up -d db) ---
DATABASE_URL=postgresql+psycopg://tracemind:tracemind@localhost:5432/tracemind

# --- Hosted MCP server (python -m tracemind.mcp_servers.http_app) ---
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
# Shared bearer token. Leave empty for an open demo (rate limits still apply).
MCP_AUTH_TOKEN=
# JSON list of public hostnames, e.g. ["tracemind-mcp.onrender.com"]
MCP_ALLOWED_HOSTS=[]
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_GLOBAL_RATE_LIMIT_PER_MINUTE=120
# true only when running behind a load balancer that sets X-Forwarded-For
MCP_TRUST_PROXY=false

# --- Client side: point the agent pipeline at a hosted MCP server instead of stdio ---
MCP_URL=
